# eBay Trading API (user token needed - not just client credentials)
EBAY_APP_ID=
EBAY_CERT_ID=
EBAY_DEV_ID=
EBAY_USER_TOKEN=
EBAY_SANDBOX=false

# Gmail API
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json
GMAIL_POLL_INTERVAL=60

# Vinted email sender address
VINTED_SENDER=no-reply@vinted.co.uk
